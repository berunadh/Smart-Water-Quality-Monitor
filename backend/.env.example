# ==============================================================================
# SMART WATER QUALITY MONITOR — BACKEND CONFIGURATION (PHASE 2)
# ==============================================================================

# Operating Mode: "demo" (simulated realistic streams) or "real" (ThingSpeak cloud)
DATA_MODE=demo
DEVICE_ID=esp32-water-monitor-01

# ThingSpeak Telemetry Integration (Used when DATA_MODE=real)
THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY
POLL_INTERVAL_SECONDS=20

# Database Configuration (SQLite default for Apple Silicon / local dev)
DATABASE_URL=sqlite:///./water_quality.db

# Alert Notification Thresholds (EPA / WHO Standards)
THRESHOLD_PH_MIN=6.5
THRESHOLD_PH_MAX=8.5
THRESHOLD_TURBIDITY_NTU_MAX=5.0
THRESHOLD_TDS_PPM_MAX=500.0

# AI Chatbot & LLM Integration
# Options for LLM_PROVIDER: "fallback" (local offline domain rules), "gemini", "openai"
LLM_PROVIDER=fallback
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=YOUR_LLM_API_KEY
