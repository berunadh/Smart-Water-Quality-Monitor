# ==============================================================================
# SMART WATER QUALITY MONITOR — BACKEND CONFIGURATION
# ==============================================================================

PROJECT_NAME="Smart Apartment Water Quality Monitor"
VERSION="1.0.0-phase1"
ENVIRONMENT="development"
DEBUG=true

# Database (SQLite default for development & edge deployments)
DATABASE_URL="sqlite:///./water_quality.db"

# ThingSpeak Telemetry Integration (Phase 2)
THINGSPEAK_CHANNEL_ID="0"
THINGSPEAK_READ_API_KEY=""
THINGSPEAK_FETCH_INTERVAL_SECONDS=30

# Alert Notification Thresholds
THRESHOLD_PH_MIN=6.5
THRESHOLD_PH_MAX=8.5
THRESHOLD_TURBIDITY_NTU_MAX=5.0
THRESHOLD_TDS_PPM_MAX=500.0

# AI Chatbot & LLM Integration (Phase 2)
# Provide Gemini API key when configuring the advisor chatbot in Phase 2
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"
